# Copy this file to .env and fill in values. NEVER commit .env (it is in .gitignore).
# If .env was ever committed, rotate all secrets (SMTP password, JWT secret, STAFF_ACCESS_KEY).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/arckae

# JWT configuration
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins for the React frontend (comma-separated)
# For local dev with Vite:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=arckae.int@gmail.com
SMTP_USE_TLS=true

# Staff access gate
# Shared secret used in /api/auth/staff-gate to verify staff before showing login
STAFF_ACCESS_KEY=123987123

